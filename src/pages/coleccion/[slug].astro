---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export async function getStaticPaths() {
	const cols = await getCollection('productCollections');
	return cols.map((c) => ({ params: { slug: c.data.slug } }));
}

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect('/shop/');
}
const pcols = await getCollection('productCollections');
const col = pcols.find((c) => c.data.slug === slug);
if (!col) {
	return Astro.redirect('/shop/');
}
const d = col.data;
const allProducts = (await getCollection('products'))
	.filter((p) => p.data.collection === slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const firstHero = d.heroImage;
const origin = (Astro.site && Astro.site.href) || `${SITE_URL}/`;
const pageUrl = new URL(Astro.url.pathname, origin).toString();
const og = firstHero
	? await getImage({ src: firstHero, width: 1200, quality: 85, format: 'jpg' })
	: null;
const ogUrl = og
	? new URL(og.src, origin).toString()
	: new URL('/android-chrome-512x512.png', origin).toString();
const colJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: d.title,
	description: d.description,
	url: pageUrl,
};
const breadcrumb: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: origin },
		{ '@type': 'ListItem', position: 2, name: 'Tienda', item: new URL('/shop/', origin).toString() },
		{ '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
	],
};
const pageTitle = `${d.title} | Colección | ${SITE_TITLE}`;
const hd = {
	tex: 'https://images.unsplash.com/photo-1579546929662-711aa81148cf?w=2048&q=95',
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={pageTitle}
			description={d.description || SITE_DESCRIPTION}
			image={ogUrl}
			ogImageType={og ? 'image/jpeg' : 'image/png'}
			extraJsonLd={[colJsonLd, breadcrumb]}
		/>
		<style
			define:vars={{
				textureBg: `url(${hd.tex})`,
			}}
		>
			body {
				margin: 0;
				font-family: 'Atkinson', sans-serif;
				background: var(--background);
				color: var(--text);
			}
			.portal-bg {
				position: fixed;
				inset: 0;
				background: var(--background);
				z-index: -1;
			}
			.portal-bg::before {
				content: '';
				position: absolute;
				inset: 0;
				background: var(--textureBg) center/cover;
				opacity: 0.04;
			}
			.col-hero {
				text-align: center;
				padding: 4.5rem 1.5rem 2rem;
			}
			.col-hero h1 {
				color: var(--secondary);
				margin: 0 0 0.75rem;
			}
			.col-hero-figure {
				max-width: 720px;
				margin: 0 auto 1.5rem;
			}
			.col-hero-figure img {
				width: 100%;
				border-radius: 16px;
			}
			.col-lede {
				max-width: 40rem;
				margin: 0 auto 2rem;
				padding: 0 1.5rem;
				font-size: 1.1rem;
				line-height: 1.5;
			}
			.shop-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
				gap: 1.25rem;
				padding: 0 1.5rem 3rem;
				max-width: 1200px;
				margin: 0 auto;
			}
			.shop-card {
				background: rgba(var(--primary-dark-rgb), 0.5);
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid rgba(var(--secondary-rgb), 0.12);
			}
			.shop-card a {
				color: inherit;
				text-decoration: none;
			}
			.shop-card h2 {
				color: var(--secondary);
				font-size: 1.1rem;
				margin: 0 0 0.4rem;
				padding: 1rem 1rem 0.25rem;
			}
			.shop-card p {
				margin: 0 0 1rem;
				padding: 0 1rem 1rem;
				font-size: 0.9rem;
			}
			.shop-card-img {
				width: 100%;
				aspect-ratio: 1;
				object-fit: cover;
			}
		</style>
	</head>
	<body>
		<div class="portal-bg" aria-hidden="true"></div>
		<Header />
		<main>
			<div class="col-hero">
				{firstHero && (
					<figure class="col-hero-figure">
						<Image src={firstHero} alt={d.title} width={720} quality={90} />
					</figure>
				)}
				<h1>{d.title}</h1>
			</div>
			<div class="col-lede">
				<p>{d.description}</p>
			</div>
			<div class="shop-grid">
				{
					allProducts.map((p) => {
						const img0 = p.data.images[0]!;
						return (
							<article class="shop-card">
								<a href={`/shop/${p.data.slug}/`}>
									<Image
										class="shop-card-img"
										src={img0}
										alt={p.data.title}
										widths={[400, 800]}
										sizes="(max-width: 700px) 100vw, 25vw"
										loading="lazy"
									/>
									<h2>{p.data.title}</h2>
									<p>{p.data.shortDescription}</p>
								</a>
							</article>
						);
					})
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

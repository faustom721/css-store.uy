---
const instagramUser = "css_store_uy";
const profileUrl = `https://www.instagram.com/${instagramUser}/`;

const posts = [
  { shortcode: "DNBrUdUuNxw", type: "p" },
  { shortcode: "DMySANAJp3B", type: "reel" },
  { shortcode: "DMbSYAFplB-", type: "p" },
];
---

<section class="instagram-section">
  <div class="instagram-container">
    <div class="instagram-header">
      <svg class="instagram-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
      </svg>
      <h2>@{instagramUser}</h2>
      <p class="instagram-subtitle">Medias con estilo, y algo mas</p>
    </div>
    <div class="instagram-grid">
      {posts.map((post) => (
        <div class="instagram-post">
          <iframe
            src={`https://www.instagram.com/${post.type}/${post.shortcode}/embed/`}
            allowtransparency="true"
            frameborder="0"
            scrolling="no"
            loading="lazy"
          />
        </div>
      ))}
    </div>
    <div class="instagram-cta">
      <a href={profileUrl} target="_blank" rel="noopener noreferrer" class="instagram-follow-btn">
        Seguinos en Instagram
      </a>
    </div>
  </div>
</section>

<style>
  .instagram-section {
    padding: 8rem 0;
    background: var(--background);
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at 30% 50%, rgba(var(--secondary-rgb), 0.08) 0%, transparent 60%),
        radial-gradient(circle at 70% 50%, rgba(var(--primary-rgb), 0.08) 0%, transparent 60%);
    }
  }

  .instagram-container {
    max-width: 2400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
  }

  .instagram-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .instagram-icon {
    width: 48px;
    height: 48px;
    color: var(--secondary);
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px var(--glow));
  }

  .instagram-header h2 {
    color: var(--secondary);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0;
    text-shadow: 0 0 20px var(--glow);
  }

  .instagram-subtitle {
    color: var(--text);
    opacity: 0.8;
    font-size: 1.1rem;
    margin: 0.5rem 0 0;
  }

  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .instagram-post {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(var(--secondary-rgb), 0.15);
    background: rgba(var(--primary-dark-rgb), 0.5);
    transition: all 0.3s ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      border-color: rgba(var(--secondary-rgb), 0.3);
    }
  }

  .instagram-post iframe {
    width: 100%;
    min-height: 480px;
    border: none;
    display: block;
  }

  .instagram-cta {
    text-align: center;
    margin-top: 3rem;
  }

  .instagram-follow-btn {
    display: inline-block;
    background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    color: #fff;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-size: 1.2rem;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(225, 48, 108, 0.3);
  }

  .instagram-follow-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 25px rgba(225, 48, 108, 0.5);
  }

  @media (max-width: 1024px) {
    .instagram-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 768px) {
    .instagram-section {
      padding: 4rem 0;
    }

    .instagram-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .instagram-container {
      padding: 0 1rem;
    }

    .instagram-post iframe {
      min-height: 420px;
    }
  }
</style>

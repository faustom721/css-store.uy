<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(var(--primary-dark-rgb), 0.3);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(var(--secondary-rgb), 0.1);
		position: sticky;
		top: 0;
		z-index: 1000;
	}

	h2 {
		margin: 0;
		font-size: 1.5em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--secondary);
		text-shadow: 0 0 10px var(--glow);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 0;
	}

	nav a {
		padding: 0.5em;
		color: var(--text);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 1.1em;
		transition: all 0.3s ease;
	}

	nav a:hover {
		color: var(--secondary);
		border-bottom-color: var(--secondary);
		text-shadow: 0 0 10px var(--glow);
	}

	nav a.active {
		color: var(--secondary);
		border-bottom-color: var(--secondary);
		text-shadow: 0 0 10px var(--glow);
	}

	.internal-links {
		display: flex;
		gap: 1em;
	}

	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	.social-links a {
		padding: 0.5em;
		border-radius: 50%;
		transition: all 0.3s ease;
		background: rgba(var(--primary-dark-rgb), 0.5);
	}

	.social-links a:hover {
		background: rgba(var(--primary-dark-rgb), 0.7);
		transform: translateY(-2px);
	}

	.social-links svg {
		width: 24px;
		height: 24px;
		color: var(--text);
		transition: color 0.3s ease;
	}

	.social-links a:hover svg {
		color: var(--secondary);
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}

		nav {
			padding: 0.5rem 0;
		}

		h2 {
			font-size: 1.2em;
		}

		nav a {
			font-size: 1em;
			padding: 0.3em;
		}
	}
</style>